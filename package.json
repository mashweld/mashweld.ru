{
  "name": "mashweld.ru",
  "version": "0.0.1",
  "description": "Company website",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.3"
  },
  "scripts": {
    "start": "gulp watch",
    "build": "gulp default",
    "deploy": "gulp gh",
    "test": "npm run build && playwright test",
    "test:update": "npm run build && playwright test --update-snapshots",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:pug",
    "lint:js": "eslint gulpfile.js",
    "lint:css": "stylelint 'src/scss/**/*.scss'",
    "lint:pug": "pug-lint src/templates/",
    "deps:check": "npx npm-check-updates",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs}": "eslint",
    "*.scss": "stylelint",
    "*.pug": "pug-lint"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:mashweld/mashweld.github.io.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "autoprefixer": "10.4.27",
    "browser-sync": "3.0.4",
    "cssnano": "6.1.2",
    "del": "6.1.1",
    "eslint": "10.0.3",
    "gh-pages": "6.3.0",
    "globals": "17.4.0",
    "gulp": "5.0.1",
    "gulp-filter": "5.1.0",
    "gulp-html-minifier-terser": "7.1.0",
    "gulp-postcss": "9.0.1",
    "gulp-pug": "5.0.0",
    "gulp-rename": "2.1.0",
    "gulp-replace": "1.1.4",
    "gulp-sass": "6.0.1",
    "postcss": "8.5.8",
    "pug-lint": "2.7.0",
    "serve": "14.2.6",
    "lint-staged": "16.3.3",
    "simple-git-hooks": "2.13.1",
    "sass": "1.98.0",
    "stylelint": "17.4.0",
    "stylelint-config-standard-scss": "17.0.0"
  }
}
